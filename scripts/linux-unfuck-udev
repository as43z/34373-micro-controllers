#!/usr/bin/env bash
# Define rules for both V3 standard and V3 Power variants
cat <<EOF | sudo tee /etc/udev/rules.d/99-stlink-custom.rules
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="374b", MODE="0666"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="3757", MODE="0666"
EOF

# Reload and trigger
sudo udevadm control --reload-rules
sudo udevadm trigger

# Verification (Check permissions of the specific USB node)
# Based on your lsusb: Bus 003 Device 004
ls -l /dev/bus/usb/003/004
